# Node
node_modules/
dist/

# Secrets
.env
.env.*
!.env.example
secrets.toml

# 第三方素材:授權不允許原樣再散佈,只放本機
profiles/*/avatar/model/
profiles/*/voice/*.wav
profiles/*/voice/*.txt

# Spikes:錄音、模型、評測結果只放本機
spikes/voice-node/recordings/
spikes/speech-bench/models/
spikes/speech-bench/results/
spikes/speech-bench/out/
**/.venv/
__pycache__/

# 資料庫備份(scripts/backup.sh):只放本機 / 自己的備份位置
/backups/

# 本機設定(用 `miyoria init` / `miyoria config` 產生)
/miyoria.toml

# TypeScript build state
*.tsbuildinfo
coverage/

# 本機執行資料與 Python 虛擬環境
/data/
workers/.venv-*/

# Claude Code 子代理的暫存 worktree,和它的預覽設定
/.claude/worktrees/
/.claude/launch.json

# 測試和建置的暫存資料夾(pytest --basetemp、esbuild 被防毒卡住時改用的 TMP)
pytest-of-*/
.pytest-tmp/
.tmp-build/
# pip 和 PyTorch 在工作資料夾留下的暫存(pip 的 metadata / unpack、torch inductor 快取)
/workers/pip-metadata-*/
/workers/pip-unpack-*/
/torchinductor_*/
/workers/torchinductor_*/
# The owner's panel pictures (background, login): game art, local only
apps/panel/public/*.local.*

# Live2D Cubism Core and Web Framework, fetched per apps/card-studio/vendor.md (Live2D licences)
/apps/card-studio/vendor/
/apps/card-studio/dist/

# MediaMTX binary (downloaded, see workers/mediamtx/README.md)
workers/mediamtx/mediamtx.exe
workers/mediamtx/LICENSE
workers/mediamtx/mediamtx.log
