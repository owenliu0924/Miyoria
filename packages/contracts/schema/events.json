        "rows_removed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "blobs_removed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "bytes_freed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "orphan_files_removed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
