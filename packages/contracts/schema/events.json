{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "@miyoria/contracts/events",
  "$defs": {
    "EventsDraft": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "at": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "v": {
          "default": 1,
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "parent": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "turn": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "session": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "space_id": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "room_id": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "person_id": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "account_id": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "scope": {
          "default": null,
          "anyOf": [
            {
              "$ref": "#/$defs/EventsScope"
            },
            {
              "type": "null"
            }
          ]
        },
        "key": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "data": {
          "$ref": "#/$defs/WireJsonValue"
        }
      },
      "required": [
        "id",
        "at",
        "type",
        "data"
      ]
    },
    "EventsEnvelope": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "at": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "v": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "parent": {
          "type": [
            "string",
            "null"
          ]
        },
        "turn": {
          "type": [
            "string",
            "null"
          ]
        },
        "session": {
          "type": [
            "string",
            "null"
          ]
        },
        "space_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "room_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "person_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "account_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "key": {
          "type": [
            "string",
            "null"
          ]
        },
        "seq": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/EventsScope"
        },
        "tier": {
          "$ref": "#/$defs/EventsTier"
        },
        "redacted_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "data": {
          "$ref": "#/$defs/WireJsonValue"
        }
      },
      "required": [
        "id",
        "at",
        "type",
        "v",
        "parent",
        "turn",
        "session",
        "space_id",
        "room_id",
        "person_id",
        "account_id",
        "key",
        "seq",
        "source",
        "scope",
        "tier",
        "redacted_at",
        "data"
      ]
    },
    "EventsPlatformMessage": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/WireMessageRef"
        },
        "author": {
          "$ref": "#/$defs/WireAuthor"
        },
        "text": {
          "type": "string"
        },
        "mentions_self": {
          "type": "boolean"
        },
        "reply_to_self": {
          "type": "boolean"
        },
        "attachments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WireAttachment"
          }
        },
        "ts": {
          "type": "string"
        },
        "reply_to": {
          "anyOf": [
            {
              "$ref": "#/$defs/WireMessageRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "referenced": {
          "anyOf": [
            {
              "$ref": "#/$defs/WireQuotedMessage"
            },
            {
              "type": "null"
            }
          ]
        },
        "stickers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WireSticker"
          }
        },
        "embeds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WireEmbed"
          }
        },
        "forwarded": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WireForwardedMessage"
          }
        },
        "mentions_others": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WireMentionedAccount"
          }
        },
        "opens_with_other_mention": {
          "type": "boolean"
        },
        "turn_complete": {
          "type": "boolean"
        },
        "card": {
          "type": "boolean"
        },
        "self": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "author",
        "text",
        "mentions_self",
        "reply_to_self",
        "attachments",
        "ts"
      ]
    },
    "EventsRedactedData": {
      "type": "object",
      "properties": {
        "redacted": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "redacted"
      ]
    },
    "EventsScope": {
      "type": "string",
      "enum": [
        "public",
        "space",
        "room",
        "dm",
        "self",
        "owner"
      ]
    },
    "EventsTier": {
      "type": "string",
      "enum": [
        "keep",
        "long",
        "short",
        "ambient"
      ]
    },
    "EventsVoicePlayback": {
      "type": "object",
      "properties": {
        "context": {
          "$ref": "#/$defs/WireContextKey"
        },
        "turn": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "$ref": "#/$defs/WirePlaybackState"
        },
        "text": {
          "type": "string"
        },
        "emotion": {
          "type": [
            "string",
            "null"
          ]
        },
        "heard_ms": {
          "type": [
            "number",
            "null"
          ]
        },
        "total_ms": {
          "type": [
            "number",
            "null"
          ]
        },
        "blocked": {
          "type": [
            "string",
            "null"
          ]
        },
        "speaker": {
          "$ref": "#/$defs/WireAuthor"
        }
      },
      "required": [
        "context",
        "turn",
        "state",
        "text"
      ]
    },
    "WireAccountRef": {
      "type": "object",
      "properties": {
        "platform": {
          "type": "string"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "platform",
        "id"
      ]
    },
    "WireAttachment": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        },
        "filename": {
          "type": "string"
        },
        "content_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "size": {
          "type": [
            "number",
            "null"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "url",
        "filename",
        "content_type"
      ]
    },
    "WireAuthor": {
      "type": "object",
      "properties": {
        "account": {
          "$ref": "#/$defs/WireAccountRef"
        },
        "display_name": {
          "type": "string"
        },
        "is_bot": {
          "type": "boolean"
        }
      },
      "required": [
        "account",
        "display_name",
        "is_bot"
      ]
    },
    "WireContextKey": {
      "type": "object",
      "properties": {
        "platform": {
          "type": "string"
        },
        "scope": {
          "type": [
            "string",
            "null"
          ]
        },
        "channel": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/WireContextKind"
        }
      },
      "required": [
        "platform",
        "scope",
        "channel",
        "kind"
      ]
    },
    "WireContextKind": {
      "type": "string",
      "enum": [
        "channel",
        "thread",
        "dm",
        "voice"
      ]
    },
    "WireEmbed": {
      "type": "object",
      "properties": {
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "title",
        "description",
        "url"
      ]
    },
    "WireForwardedMessage": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "attachments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WireAttachment"
          }
        },
        "stickers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WireSticker"
          }
        },
        "embeds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WireEmbed"
          }
        }
      },
      "required": [
        "text",
        "attachments",
        "stickers",
        "embeds"
      ]
    },
    "WireJsonValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WireJsonValue"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/WireJsonValue"
          }
        }
      ]
    },
    "WireMentionedAccount": {
      "type": "object",
      "properties": {
        "account": {
          "$ref": "#/$defs/WireAccountRef"
        },
        "display_name": {
          "type": "string"
        },
        "is_bot": {
          "type": "boolean"
        }
      },
      "required": [
        "account",
        "display_name",
        "is_bot"
      ]
    },
    "WireMessageRef": {
      "type": "object",
      "properties": {
        "context": {
          "$ref": "#/$defs/WireContextKey"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "context",
        "id"
      ]
    },
    "WirePlaybackState": {
      "type": "string",
      "enum": [
        "started",
        "finished",
        "interrupted",
        "failed"
      ]
    },
    "WireQuotedMessage": {
      "type": "object",
      "properties": {
        "author": {
          "anyOf": [
            {
              "$ref": "#/$defs/WireAccountRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "author_name": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "author",
        "author_name",
        "text"
      ]
    },
    "WireSticker": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ]
    }
  }
}
