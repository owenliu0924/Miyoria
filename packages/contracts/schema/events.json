{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "@miyoria/contracts/events",
  "$defs": {
    "EventsArtifactCreated": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "mime": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/EventsArtifactKind"
        },
        "filename": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/EventsArtifactSource"
        },
        "plugin": {
          "type": "string"
        },
        "made_for": {
          "type": [
            "string",
            "null"
          ]
        },
        "derived_from": {
          "type": [
            "string",
            "null"
          ]
        },
        "expires_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "kept_by": {
          "anyOf": [
            {
              "$ref": "#/$defs/EventsArtifactKeptBy"
            },
            {
              "type": "null"
            }
          ]
        },
        "downloadable": {
          "type": "boolean"
        }
      },
      "required": [
        "artifact_id",
        "sha256",
        "size",
        "mime",
        "kind",
        "filename",
        "source",
        "plugin",
        "made_for",
        "derived_from",
        "expires_at",
        "kept_by",
        "downloadable"
      ]
    },
    "EventsArtifactExpired": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "expires_at": {
          "type": "string"
        },
        "shares_revoked": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "artifact_id",
        "sha256",
        "expires_at",
        "shares_revoked"
      ]
    },
    "EventsArtifactKeptBy": {
