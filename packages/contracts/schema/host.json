{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "@miyoria/contracts/host",
  "$defs": {
    "HostConfig": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "cluster": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "url"
          ],
          "additionalProperties": false
        },
        "paths": {
          "default": {
            "state": "data/host"
          },
          "type": "object",
          "properties": {
            "state": {
              "default": "data/host",
              "type": "string"
            },
            "ca_bundle": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "network": {
          "default": {
            "bind": "127.0.0.1"
          },
          "type": "object",
          "properties": {
            "bind": {
              "default": "127.0.0.1",
              "type": "string"
            },
            "advertise": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "gpu": {
          "default": {
            "reserve_mb": 0
          },
          "type": "object",
          "properties": {
            "reserve_mb": {
              "default": 0,
              "type": "number",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "services": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/HostServiceConfig"
          }
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "HostEndpoint": {
      "type": "object",
      "properties": {
        "capability": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "service": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "via": {
          "default": "direct",
          "type": "string",
          "enum": [
            "direct",
            "link"
          ]
        },
        "headers": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "healthy": {
          "type": "boolean"
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "capability",
        "host",
        "service",
        "url",
        "headers",
        "healthy",
        "version"
      ]
    },
    "HostGpu": {
      "type": "object",
      "properties": {
        "policy": {
          "$ref": "#/$defs/HostGpuPolicy"
        },
        "vram_mb": {
          "type": "object",
          "properties": {
            "resident": {
              "type": "number",
              "minimum": 0
            },
            "peak": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "resident",
            "peak"
          ],
          "additionalProperties": false
        },
        "offload": {
          "type": "string"
        },
        "reload": {
          "type": "string"
        },
        "busy": {
          "type": "string"
        }
      },
      "required": [
        "policy"
      ],
      "additionalProperties": false
    },
    "HostGpuPolicy": {
      "type": "string",
      "enum": [
        "pinned",
        "evictable",
        "on_demand",
        "reserve"
      ]
    },
    "HostGpuReading": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "total_mb": {
          "type": "number"
        },
        "used_mb": {
          "type": "number"
        },
        "reserve_mb": {
          "type": "number"
        }
      },
      "required": [
        "total_mb",
        "used_mb",
        "reserve_mb"
      ]
    },
    "HostGuardResult": {
      "type": "object",
      "properties": {
        "states": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/HostGuardState"
          }
        }
      },
      "required": [
        "states"
      ]
    },
    "HostGuardState": {
      "type": "string",
      "enum": [
        "singing",
        "live"
      ]
    },
    "HostHealth": {
      "type": "object",
      "properties": {
        "http": {
          "type": "string"
        },
        "tcp": {
          "type": "boolean"
        },
        "process": {
          "type": "boolean"
        },
        "startup_s": {
          "default": 180,
          "type": "number",
          "exclusiveMinimum": 0
        },
        "interval_s": {
          "default": 10,
          "type": "number",
          "exclusiveMinimum": 0
        },
        "timeout_s": {
          "default": 3,
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false
    },
    "HostHello": {
      "type": "object",
      "properties": {
        "protocol": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "host": {
          "type": "string",
          "minLength": 1
        },
        "key": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "protocol",
        "host",
        "key",
        "name",
        "platform",
        "version"
      ]
    },
    "HostInfo": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        },
        "protocol": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "gpu": {
          "anyOf": [
            {
              "$ref": "#/$defs/HostGpuReading"
            },
            {
              "type": "null"
            }
          ]
        },
        "services": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/HostServiceStatus"
          }
        }
      },
      "required": [
        "name",
        "version",
        "platform",
        "protocol",
        "gpu",
        "services"
      ]
    },
    "HostInstall": {
      "type": "object",
      "properties": {
        "runtime": {
          "default": "none",
          "type": "string",
          "enum": [
            "python",
            "node",
            "binary",
            "none"
          ]
        },
        "python": {
          "type": "string"
        },
        "project": {
          "type": "string"
        },
        "extras": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "system": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "models": {
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/$defs/HostInstallModel"
          }
        },
        "files": {
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/$defs/HostInstallFile"
          }
        },
        "manual": {
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/$defs/HostInstallManual"
          }
        },
        "requirements": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "torch": {
          "$ref": "#/$defs/HostInstallTorch"
        }
      },
      "additionalProperties": false
    },
    "HostInstallFile": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "url",
        "path"
      ],
      "additionalProperties": false
    },
    "HostInstallManual": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "what": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "path",
        "what"
      ],
      "additionalProperties": false
    },
    "HostInstallModel": {
      "type": "object",
      "properties": {
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string"
        }
      },
      "required": [
        "repo"
      ],
      "additionalProperties": false
    },
    "HostInstallTorch": {
      "type": "object",
      "properties": {
        "index": {
          "type": "string",
          "minLength": 1
        },
        "packages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "index",
        "packages"
      ],
      "additionalProperties": false
    },
    "HostLaunch": {
      "type": "object",
      "properties": {
        "command": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cwd": {
          "default": ".",
          "type": "string"
        }
      },
      "required": [
        "command"
      ],
      "additionalProperties": false
    },
    "HostPort": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        {
          "type": "string",
          "const": "auto"
        }
      ]
    },
    "HostProbe": {
      "type": "object",
      "properties": {
        "http": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "process": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "HostReport": {
      "$ref": "#/$defs/HostInfo"
    },
    "HostResolve": {
      "type": "object",
      "properties": {
        "capability": {
          "type": "string"
        }
      },
      "required": [
        "capability"
      ]
    },
    "HostResolveResult": {
      "type": "object",
      "properties": {
        "endpoints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/HostEndpoint"
          }
        }
      },
      "required": [
        "endpoints"
      ]
    },
    "HostRestart": {
      "type": "object",
      "properties": {
        "policy": {
          "default": "on-failure",
          "$ref": "#/$defs/HostRestartPolicy"
        },
        "backoff_s": {
          "default": [
            1,
            5,
            30
          ],
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "give_up": {
          "default": {
            "failures": 5,
            "window_s": 600
          },
          "type": "object",
          "properties": {
            "failures": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "window_s": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "failures",
            "window_s"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "HostRestartPolicy": {
      "type": "string",
      "enum": [
        "always",
        "on-failure",
        "never"
      ]
    },
    "HostRun": {
      "type": "object",
      "properties": {
        "command": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cwd": {
          "default": ".",
          "type": "string"
        },
        "port": {
          "$ref": "#/$defs/HostPort"
        },
        "host_env": {
          "type": "string"
        },
        "port_env": {
          "type": "string"
        },
        "env": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "pass_env": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "after": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "guard": {
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/$defs/HostGuardState"
          }
        },
        "health": {
          "default": {
            "startup_s": 180,
            "interval_s": 10,
            "timeout_s": 3
          },
          "$ref": "#/$defs/HostHealth"
        },
        "restart": {
          "default": {
            "policy": "on-failure",
            "backoff_s": [
              1,
              5,
              30
            ],
            "give_up": {
              "failures": 5,
              "window_s": 600
            }
          },
          "$ref": "#/$defs/HostRestart"
        },
        "stop": {
          "default": {
            "grace_s": 10
          },
          "$ref": "#/$defs/HostStop"
        }
      },
      "required": [
        "command"
      ],
      "additionalProperties": false
    },
    "HostService": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "worker",
            "node",
            "external"
          ]
        },
        "provides": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "platforms": {
          "default": [
            "win32",
            "linux"
          ],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "summary": {
          "default": "",
          "type": "string"
        },
        "install": {
          "default": {
            "runtime": "none",
            "extras": [],
            "system": [],
            "models": [],
            "files": [],
            "manual": [],
            "requirements": []
          },
          "$ref": "#/$defs/HostInstall"
        },
        "run": {
          "$ref": "#/$defs/HostRun"
        },
        "gpu": {
          "$ref": "#/$defs/HostGpu"
        },
        "probe": {
          "$ref": "#/$defs/HostProbe"
        },
        "launch": {
          "$ref": "#/$defs/HostLaunch"
        }
      },
      "required": [
        "name",
        "kind"
      ],
      "additionalProperties": false
    },
    "HostServiceConfig": {
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "python": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "env": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "extras": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gpu": {
          "type": "object",
          "properties": {
            "policy": {
              "$ref": "#/$defs/HostGpuPolicy"
            }
          },
          "required": [
            "policy"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "HostServiceControl": {
      "type": "object",
      "properties": {
        "service": {
          "type": "string"
        },
        "force": {
          "type": "boolean"
        }
      },
      "required": [
        "service"
      ]
    },
    "HostServiceControlResult": {
      "type": "object",
      "properties": {
        "service": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/HostServiceState"
        }
      },
      "required": [
        "service",
        "state"
      ]
    },
    "HostServiceEvent": {
      "type": "object",
      "properties": {
        "service": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/HostServiceState"
        },
        "previous": {
          "$ref": "#/$defs/HostServiceState"
        },
        "at": {
          "type": "number"
        },
        "reason": {
          "type": "string"
        },
        "log_tail": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "service",
        "state",
        "previous",
        "at"
      ]
    },
    "HostServiceList": {
      "type": "object",
      "properties": {
        "services": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/HostServiceStatus"
          }
        }
      },
      "required": [
        "services"
      ]
    },
    "HostServiceLogLine": {
      "type": "object",
      "properties": {
        "service": {
          "type": "string"
        },
        "line": {
          "type": "string"
        }
      },
      "required": [
        "service",
        "line"
      ]
    },
    "HostServiceLogs": {
      "type": "object",
      "properties": {
        "service": {
          "type": "string"
        },
        "lines": {
          "default": 100,
          "type": "integer",
          "minimum": 1,
          "maximum": 2000
        },
        "follow": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "service"
      ]
    },
    "HostServiceLogsResult": {
      "type": "object",
      "properties": {
        "lines": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "lines"
      ]
    },
    "HostServiceState": {
      "type": "string",
      "enum": [
        "stopped",
        "starting",
        "running",
        "stopping",
        "backoff",
        "failed",
        "external",
        "foreign",
        "disabled"
      ]
    },
    "HostServiceStatus": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "worker",
            "node",
            "external"
          ]
        },
        "provides": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "state": {
          "$ref": "#/$defs/HostServiceState"
        },
        "since": {
          "type": "number"
        },
        "pid": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "port": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "url": {
          "type": "string"
        },
        "healthy": {
          "type": "boolean"
        },
        "restarts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "version": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "token": {
          "type": "string"
        },
        "gpu": {
          "type": "object",
          "properties": {
            "policy": {
              "$ref": "#/$defs/HostGpuPolicy"
            },
            "resident_mb": {
              "type": "number"
            },
            "leased": {
              "type": "boolean"
            }
          },
          "required": [
            "policy",
            "leased"
          ]
        }
      },
      "required": [
        "name",
        "kind",
        "provides",
        "state",
        "since",
        "healthy",
        "restarts"
      ]
    },
    "HostShutdown": {
      "type": "object",
      "properties": {
        "force": {
          "type": "boolean"
        }
      }
    },
    "HostShutdownResult": {
      "type": "object",
      "properties": {
        "stopped": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "stopped"
      ]
    },
    "HostStop": {
      "type": "object",
      "properties": {
        "grace_s": {
          "default": 10,
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "HostWelcome": {
      "type": "object",
      "properties": {
        "protocol": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "core_version": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "approved": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "protocol",
        "core_version",
        "host",
        "approved"
      ]
    }
  }
}
