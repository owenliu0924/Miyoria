{
  "name": "@miyoria/llm",
  "version": "0.1.0",
  "description": "llm: LLM provider interface, purpose routing, cost and budget, and the OpenAI-compatible provider; tools: Tools the model may call during a turn, and their registry",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    "./llm": {
      "@miyoria/source": "./llm/src/index.ts",
      "types": "./dist/llm/src/index.d.ts",
      "default": "./dist/llm/src/index.js"
    },
    "./tools": {
      "@miyoria/source": "./tools/src/index.ts",
      "types": "./dist/tools/src/index.d.ts",
      "default": "./dist/tools/src/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@miyoria/runtime": "workspace:*",
    "@miyoria/store": "workspace:*",
    "@miyoria/types": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  }
}
