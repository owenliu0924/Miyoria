{
  "name": "@miyoria/play",
  "version": "0.1.0",
  "description": "party: Party games she hosts: turtle soup (voice or text channel) and song guessing (voice); game: Game director: picks goals, acts through game adapter tools, comments live; queue: User request queue: fair ordering, voting mode, persistence and commands; cards: Her cards for each person (module `cards`): the paid daily card, its draw by public odds with a pity, the expression by relationship, the dex with series titles and the old collectibles, the wishlist; market: The weekly market (module `market`): the song priority ticket, a weekly auction of one lot in a channel and a weekly lottery",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    "./party": {
      "@miyoria/source": "./party/src/index.ts",
      "types": "./dist/party/src/index.d.ts",
      "default": "./dist/party/src/index.js"
    },
    "./game": {
      "@miyoria/source": "./game/src/index.ts",
      "types": "./dist/game/src/index.d.ts",
      "default": "./dist/game/src/index.js"
    },
    "./queue": {
      "@miyoria/source": "./queue/src/index.ts",
      "types": "./dist/queue/src/index.d.ts",
      "default": "./dist/queue/src/index.js"
    },
    "./cards": {
      "@miyoria/source": "./cards/src/index.ts",
      "types": "./dist/cards/src/index.d.ts",
      "default": "./dist/cards/src/index.js"
    },
    "./market": {
      "@miyoria/source": "./market/src/index.ts",
      "types": "./dist/market/src/index.d.ts",
      "default": "./dist/market/src/index.js"
    },
    "./karaoke/score": {
      "@miyoria/source": "./karaoke/src/score/index.ts",
      "types": "./dist/karaoke/src/score/index.d.ts",
      "default": "./dist/karaoke/src/score/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@miyoria/commands": "workspace:*",
    "@miyoria/contracts": "workspace:*",
    "@miyoria/gate": "workspace:*",
    "@miyoria/heart": "workspace:*",
    "@miyoria/llm": "workspace:*",
    "@miyoria/runtime": "workspace:*",
    "@miyoria/store": "workspace:*",
    "@miyoria/types": "workspace:*",
    "drizzle-orm": "1.0.0-rc.5",
    "opencc-js": "^1.4.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  }
}
