{
  "name": "@miyoria/ext-wordle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Wordle tools: she plays a five-letter word game one guess at a time",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
